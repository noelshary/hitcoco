{
  "schemaVersion": 1,
  "id": "hitcolor",
  "version": "${version}",
  "name": "HitColor Client",
  "description": "An animated client hub with HitColor, HUD stats, theme controls, crosshair editor and optional mod integrations.",
  "authors": ["noelshary"],
  "contact": {
    "homepage": "https://modrinth.com/mod/hitcolor",
    "sources": "https://github.com/noelshary/hitcoco",
    "issues": "https://github.com/noelshary/hitcoco/issues"
  },
  "license": "MIT",
  "icon": "assets/hitcolor/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.hitcolor.HitColorClient"],
    "modmenu": ["dev.hitcolor.ModMenuIntegration"]
  },
  "mixins": ["hitcolor.mixins.json"],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
